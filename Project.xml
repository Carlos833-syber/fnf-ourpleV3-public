<?xml version="1.0" encoding="utf-8"?>
<project>

	<!-- Android uses the bundled assets and the Lua library declared in hmm.json. -->

	<!-- _________________________ Application Settings _________________________ -->

	<!-- [ANDROID] Package proprio: evita conflito com outros apps baseados em Psych Engine -->
	<app
		title="Vs. Ourple Guy V3"
		file="VsOurpleGuy"
		packageName="com.ourpleco.ourplev3"
		package="com.ourpleco.ourplev3"
		main="Main"
		version="0.2.8"
		company="OurpleCo"
	/>

	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<app preloader="flixel.system.FlxPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<window
		width="1280"
		height="720"
		fps="60"
		background="#000000"
		hardware="true"
		vsync="false"
	/>

	<window
		if="html5"
		resizable="true"
	/>

	<window
		if="desktop"
		orientation="landscape"
		fullscreen="false"
		resizable="true"
		vsync="false"
	/>

	<!-- [ANDROID] 0.6.x usa 1280x720 no mobile (0x0 e padrao do 0.7+) -->
	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		width="1280"
		height="720"
		resizable="false"
	/>

	<window
		if="switch"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="true"
	/>

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<!-- Lime otherwise merges ARMv7 into its default Android architectures. -->
	<architecture name="ARM64" exclude="ARMV7" if="android" />

	<!-- __________________________ Psych Engine Customization __________________ -->

	<define name="MODS_ALLOWED" />

	<define name="LUA_ALLOWED" if="desktop || android" />

	<!-- [TESTE] Videos seguem desligados no Android na primeira build.            -->
	<!-- Depois que abrir, troque pela linha comentada abaixo.                     -->
	<define name="VIDEOS_ALLOWED" if="desktop" />
	<!-- <define name="VIDEOS_ALLOWED" if="desktop || android" unless="32bits" /> -->

	<define name="CRASH_HANDLER" if="desktop release" />

	<!-- ________________________________ Assets ________________________________ -->

	<assets
		path="assets/preload"
		rename="assets"
		exclude="*.ogg"
		if="web"
	/>

	<assets
		path="assets/preload"
		rename="assets"
		exclude="*.mp3"
		unless="web"
	/>

	<library name="videos" preload="true" />
	<library name="songs" preload="false" />
	<library name="shared" preload="false" />

	<assets
		path="assets/videos"
		library="videos"
		if="VIDEOS_ALLOWED"
	/>

	<assets
		path="assets/songs"
		library="songs"
		exclude="*.ogg"
		if="web"
	/>

	<assets
		path="assets/songs"
		library="songs"
		exclude="*.mp3"
		unless="web"
	/>

	<assets
		path="assets/shared"
		library="shared"
		exclude="*.ogg"
		if="web"
	/>

	<assets
		path="assets/shared"
		library="shared"
		exclude="*.mp3"
		unless="web"
	/>

	<assets
		path="assets/shaders"
		library="shaders"
	/>

	<!-- [ANDROID] embed="true" coloca esses assets dentro do executavel nativo.   -->
	<!-- Em celular isso pode estourar memoria/tamanho, entao la fica embed=false. -->
	<assets
		path="assets/ourplesecrets"
		library="ourplesecrets"
		embed="true"
		if="desktop"
	/>
	<assets
		path="assets/ourplesecrets"
		library="ourplesecrets"
		embed="false"
		if="android"
	/>

	<assets
		path="assets/shared/images/characters/secret"
		embed="true"
		if="desktop"
	/>
	<assets
		path="assets/shared/images/characters/secret"
		embed="false"
		if="android"
	/>

	<assets
		path="shitposts"
		embed="false"
	/>

	<!-- _________________________________ Mods _________________________________ -->

	<section if="MODS_ALLOWED">
		<assets
			path="example_mods"
			rename="mods"
			embed="false"
			unless="android"
		/>
		<assets path="example_mods" rename="mods" embed="false" type="binary" exclude="*.mp3" if="android" />
	</section>

	<assets path="assets/fonts" />

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />

	<haxedev set="webgl" />

	<haxelib name="flixel-addons" />

	<haxelib name="hscript" />

	<define name="hscriptPos" />

	<haxelib name="flixel-ui" />

	<haxelib
		name="linc_luajit"
		if="LUA_ALLOWED"
	/>

	<haxelib
		name="hxCodec"
		if="VIDEOS_ALLOWED"
	/>


	<haxelib
		name="faxe"
		if="switch"
	/>

	<haxelib
		name="discord_rpc"
		if="desktop"
	/>

	<haxelib
		name="hxcpp-debug-server"
		if="debug"
	/>

	<!-- Scripts and bundled mods are copied to the app's private storage. -->
	<config type="android" minimum-sdk-version="23" target-sdk-version="34" build-tools-version="34.0.0" if="android" />

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<haxedef
		name="HXC_DEBUG_TRACE"
		if="debug"
	/>

	<haxedef
		name="FLX_NO_DEBUG"
		unless="debug"
	/>

	<haxedef
		name="NAPE_RELEASE_BUILD"
		unless="debug"
	/>

	<haxedef
		name="HXCPP_CHECK_POINTER"
		if="CRASH_HANDLER"
	/>

	<haxedef
		name="HXCPP_STACK_LINE"
		if="CRASH_HANDLER"
	/>

	<!-- _________________________________ Icons __________________________________ -->

	<icon path="art/icon16.png" size="16" />
	<icon path="art/icon32.png" size="32" />
	<icon path="art/icon64.png" size="64" />
	<icon path="art/iconOG.png" />

</project>
